---
// Meet the founder: her photo and story, a single line of her best-known honours, and the way to
// her full profile (where the whole list is: src/pages/leadership/hetal-shah.astro).
import { Image } from 'astro:assets';
import { founder } from '../data/home';
import hetal from '../assets/hetal-shah.png';
import { href } from '../lib/url';
---
<section class="block founder" id="founder" aria-labelledby="founder-title">
  <div class="wrap">
    <div class="founder-card reveal">
      <div class="founder-photo">
        <Image src={hetal} alt={founder.name} widths={[320, 440, 622]} sizes="(min-width: 488px) 440px, calc(100vw - 48px)" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">{founder.eyebrow}</p>
        <h2 id="founder-title">{founder.name}</h2>
        <p class="founder-role">{founder.role}</p>
        <p>{founder.bio}</p>
        <div class="chips" style="margin:18px 0 6px">{founder.chips.map(c => <span class="chip">{c}</span>)}</div>
        <p class="founder-honours"><span class="sr-only">Recognition: </span>{founder.recognition.filter(r => r.home).map(r => <span>{r.label}</span>)}</p>
        <a class="text-link" href={href(founder.link.href)}>{founder.link.label}</a>
      </div>
    </div>
  </div>
</section>
