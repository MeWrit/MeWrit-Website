---
// Who leads the work: a slim light panel, kept secondary because the site leads with its services.
// The full story is on her profile (src/pages/leadership/hetal-shah.astro).
import { credentials } from '../../data/pitch';
---
<section class="pitch-sec pitch-light pitch-cred" id="credentials" aria-labelledby="pitch-cred-title">
  <div class="wrap">
    <div class="pitch-panel pitch-slim">
      <div class="cred-band reveal">
        <div>
          <p class="eyebrow pitch-eyebrow">{credentials.eyebrow}</p>
          <h2 class="cred-title" id="pitch-cred-title">{credentials.title}</h2>
        </div>
        <div>
          <p class="cred-text">{credentials.text}</p>
          <a class="text-link" href={credentials.link.href}>{credentials.link.label}</a>
        </div>
        <ul class="cred-values" aria-label="Values">{credentials.values.map((v, i) => <>{i > 0 && ' '}<li>{v}</li></>)}</ul>
      </div>
    </div>
  </div>
</section>
