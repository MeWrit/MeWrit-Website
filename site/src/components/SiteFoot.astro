---
// The foot of the film's pages (the home page and the practices' own pages): a slim bar along the bottom
// of the screen, as the header runs along the top. Opened (its button, a link to #contact anywhere on
// the page, or by itself at the end of the scroll) it rises into the colophon: the practices, MeWriT,
// how to write to us and the office. On phones the bar says less and the colophon is a sheet from the
// bottom. In dusk indigo, the film's third ground (between its night and its cream); the logo sits on a
// cream card there, never on the dark itself. Script: src/scripts/foot.js; styles: src/styles/foot.css.
import { contact, office } from '../data/site';
import { practicePages } from '../data/experience';
import { CHAPTERS } from '../scripts/xp/scenes.js';
import { href } from '../lib/url';
import '../styles/foot.css';

const logo = href('/brand/logo-original.png');
const ext = { target: '_blank', rel: 'noopener' };
---
<footer class="sf" id="contact" data-open="false" aria-label="Contact and colophon">
  <div class="sf-bar">
    <a class="sf-brand" href={href('/')}>MeWriT</a>
    <span class="sf-sep sf-wide" aria-hidden="true">·</span><a class="sf-wide" href={contact.phoneHref}>{contact.phoneDisplay}</a>
    <span class="sf-sep sf-wide" aria-hidden="true">·</span><a class="sf-wide" href={`mailto:${contact.email}`}>{contact.email}</a>
    <span class="sf-sep sf-narrow" aria-hidden="true">·</span><span class="sf-narrow">Contact</span>
    <button class="sf-toggle" type="button" aria-expanded="false" aria-controls="sf-panel"><span class="sf-open">Open</span><span class="sf-close">Close</span><i aria-hidden="true"></i></button>
  </div>
  <div class="sf-panel" id="sf-panel" inert>
    <div class="sf-cols">
      <div class="sf-col sf-about">
        <span class="sf-card"><img src={logo} alt="MeWriT, Writing Science Right" width="1112" height="230" loading="lazy"></span>
        <p>Specialist medical writing and scientific communication for the clinical research and healthcare sector.</p>
      </div>
      <div class="sf-col">
        <h3>The practices</h3>
        <ul>{CHAPTERS.map((c, j) => <li><a href={href(`/services/${practicePages[j]}/`)}>{c}</a></li>)}</ul>
      </div>
      <div class="sf-col">
        <h3>MeWriT</h3>
        <ul>
          <li><a href={href('/leadership/hetal-shah/')}>Dr Hetal Shah</a></li>
          <li><a href={contact.academy} {...ext}>MeWriT Academy <span aria-hidden="true">↗</span></a></li>
          <li><a href={contact.linkedin} {...ext}>LinkedIn <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
      <div class="sf-col">
        <h3>Write to us</h3>
        <ul>
          <li><a href={contact.phoneHref}>{contact.phoneDisplay}</a></li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={contact.whatsapp} {...ext}>WhatsApp <span aria-hidden="true">↗</span></a></li>
        </ul>
        <address>{office.map(l => <span>{l}</span>)}</address>
      </div>
    </div>
    <p class="sf-colophon"><span>© <span data-year>{new Date().getFullYear()}</span> MeWriT</span><span>Made with <span class="sf-heart" role="img" aria-label="love">♥</span> by <a href="https://github.com/Git-Ansh" {...ext}>Ansh Shah</a></span></p>
  </div>
</footer>
<script>
  import '../scripts/foot.js';
</script>
