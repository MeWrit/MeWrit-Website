---
// The photos, one at a time over the whole screen (the Gallery and an event's page): a photo with its
// caption and a way to its event, how many there are, the previous and the next (arrows, the keyboard's
// arrow keys, a swipe), and Close (or Escape). It opens from any link marked data-vw inside a block marked
// data-vw-set, at that photo, among that block's photos; each link's own address is the full photo, so
// without scripts a photo still opens. Script: src/scripts/viewer.js; styles: src/styles/showcase.css.
---
<dialog class="vw" id="photoViewer" aria-label="Photos">
  <div class="vw-bar">
    <p class="vw-count" aria-live="polite"></p>
    <button class="vw-close" type="button" aria-label="Close the photos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </div>
  <figure class="vw-fig">
    <div class="vw-stage"><img class="vw-img" alt="" decoding="async"></div>
    <figcaption class="vw-cap"><span class="vw-t"></span><a class="vw-ev" hidden>About the event <span aria-hidden="true">→</span></a></figcaption>
  </figure>
  <button class="vw-nav vw-prev" type="button" aria-label="Previous photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
  <button class="vw-nav vw-next" type="button" aria-label="Next photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
</dialog>
<script>
  import '../scripts/viewer.js';
</script>
