---
// Nav lab, the ask bar (data-nav="ask"): a search-first header. Type what needs writing and the
// matching service comes up; choosing it opens the enquiry form already filled in. "Menu" keeps
// the plain list for browsing. Behaviour: src/scripts/nav-experiments.js.
import { askChips, navEntries } from '../data/site';
import { href } from '../lib/url';
---
<div class="ask">
  <div class="ask-field">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
    <input id="askInput" type="search" placeholder="What do you need written?" autocomplete="off" spellcheck="false"
      role="combobox" aria-expanded="false" aria-controls="askList" aria-autocomplete="list" aria-label="What do you need written?">
  </div>
  <button class="ask-menu-btn" id="askMenuBtn" aria-expanded="false" aria-controls="askMenu">Menu</button>
  <div class="ask-pop" id="askPop" hidden>
    <p class="ask-hint">Popular</p>
    <div class="ask-chips">{askChips.map(c => <button type="button" data-q={c}>{c}</button>)}</div>
    <ul class="ask-list" id="askList" role="listbox" aria-label="Matches" hidden></ul>
  </div>
  <nav class="ask-menu" id="askMenu" aria-label="Main" hidden>
    {navEntries.map(e => <a href={href(e.href)}>{e.label}</a>)}
  </nav>
</div>
