---
// Events, under the header's Showcase: the page (/events/) and a page for each event of the record
// (/events/<id>/). Built where the record is (src/private/, read by src/data/showcase.ts); without it
// nothing is built here, and the header marks Events Soon.
import EventsIndex from '../../components/showcase/EventsIndex.astro';
import EventPage from '../../components/showcase/EventPage.astro';
import { events, hasEvents } from '../../data/showcase';

export function getStaticPaths() {
  if (!hasEvents) return [];
  return [{ params: { path: undefined } }, ...events.map(e => ({ params: { path: e.id } }))];
}
const { path } = Astro.params;
const e = path ? events.find(x => x.id === path) : undefined;
---
{e ? <EventPage e={e} /> : <EventsIndex />}
