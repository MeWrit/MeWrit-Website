---
// The archive: every draft of the site before the experience became the home page (2026-10-13),
// kept whole and working. Out of search results (Base sets noindex under /archive/).
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { href } from '../../lib/url';

const drafts = [
  { path: '/archive/house/', name: 'The scroll film', note: 'Illustrated 3D rooms, one chapter per practice, a camera that walks between them. October 2026.' },
  { path: '/archive/original/', name: 'The original site', note: 'The first white draft, with the logo intro over the page.' },
  { path: '/archive/original-b/', name: 'The original site, version B', note: 'The same page with the logo drawing itself in the header instead.' },
  { path: '/archive/lamplight/', name: 'Lamplight', note: 'The film before the rooms: a desk under a lamp. With its design board, worlds bench and an inner page.' },
  { path: '/archive/nav-lab/', name: 'Navigation lab', note: 'Header and phone menu variants side by side.' },
];
---
<Base title={`Archive | ${site.name}`} description="Earlier drafts of the MeWriT website.">
  <main class="arc">
    <h1>Archive</h1>
    <p class="arc-lede">Earlier drafts of this website, kept as they were.</p>
    <ul>
      {drafts.map(d => <li><a href={href(d.path)}><span class="t">{d.name}</span><span class="n">{d.note}</span></a></li>)}
    </ul>
  </main>
</Base>

<style>
  .arc { max-width: 44rem; margin: 0 auto; padding: calc(var(--header-h, 72px) + 3rem) 16px 5rem; }
  .arc h1 { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 .4rem; }
  .arc-lede { margin: 0 0 2rem; opacity: .75; }
  .arc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; }
  .arc a { display: grid; gap: .25rem; padding: 1rem 1.1rem; border: 1px solid rgba(0, 0, 0, .12); border-radius: 12px; text-decoration: none; color: inherit; }
  .arc a:hover, .arc a:focus-visible { border-color: currentColor; }
  .arc .t { font-weight: 600; font-size: 1.1rem; }
  .arc .n { opacity: .7; font-size: .95rem; }
</style>
