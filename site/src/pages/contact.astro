---
// Contact: every way to reach MeWriT on one screen (computers) or one short scroll (phones). On dusk
// indigo, the quick ways (email, call, WhatsApp), the office on Google Maps with its address (which
// opens the directions), and LinkedIn and the Academy; on cream, the enquiry form: what it is about,
// who is asking, the message. Few words, large targets; the layout fits the screen it is on
// (src/styles/contact.css). The form's sending and the copy buttons: src/scripts/contact.js. Without
// scripts the form still sends, as an email from the visitor's mail app.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BackLink from '../components/BackLink.astro';
import { contact, office, maps, formEndpoint } from '../data/site';
import { CHAPTERS } from '../scripts/xp/scenes.js';
import '../styles/contact.css';

const ext = { target: '_blank', rel: 'noopener' };
const action = formEndpoint || `mailto:${contact.email}`;
---
<Base title="Contact | MeWriT" description="Write, call or message MeWriT, or send an enquiry: regulatory writing, scientific publications, medical communications, training and AI/ML advisory. Satellite, Ahmedabad." foot="film" page="contact">
  <div class="ct">
    <section class="ct-reach" aria-labelledby="ct-title">
      <div class="ct-in">
        <div><BackLink dark /></div>
        <p class="ct-kicker">Contact</p>
        <h1 class="ct-title" id="ct-title">Let’s talk</h1>
        <p class="ct-line">Write, call or message, whichever suits you best.</p>
        <ul class="ct-ways">
          <li>
            <a class="ct-way" href={`mailto:${contact.email}`}><span class="ct-ico"><Icon name="mail" size={19} /></span><span class="ct-k">Email</span><span class="ct-v">{contact.email}</span></a>
            <button class="ct-copy" type="button" data-copy={contact.email} aria-label="Copy the email address"><Icon name="copy" size={15} /></button>
          </li>
          <li>
            <a class="ct-way" href={contact.phoneHref}><span class="ct-ico"><Icon name="phone" size={18} /></span><span class="ct-k">Call</span><span class="ct-v">{contact.phoneDisplay}</span></a>
            <button class="ct-copy" type="button" data-copy={contact.phoneDisplay} aria-label="Copy the phone number"><Icon name="copy" size={15} /></button>
          </li>
          <li>
            <a class="ct-way" href={contact.whatsapp} {...ext}><span class="ct-ico"><Icon name="whatsapp" size={19} /></span><span class="ct-k">WhatsApp</span><span class="ct-v">Message us</span></a>
          </li>
        </ul>
        <div class="ct-office">
          <div class="ct-map"><iframe title="MeWriT's office, Santorini Square, Satellite, on Google Maps" src={maps.embed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
          <a class="ct-addr" href={maps.directions} {...ext} aria-label={`Directions to the office on Google Maps: ${office.join(', ')}`}>
            <span class="ct-ico"><Icon name="pin" size={18} /></span>
            <address>{office.map(l => <span>{l}</span>)}</address>
            <span class="ct-dir" aria-hidden="true">Directions ↗</span>
          </a>
        </div>
        <p class="ct-more">
          <a href={contact.linkedin} {...ext}><Icon name="linkedin" size={16} />LinkedIn <span aria-hidden="true">↗</span></a>
          <a href={contact.academy} {...ext}><Icon name="cap" size={17} />Courses: MeWriT Academy <span aria-hidden="true">↗</span></a>
        </p>
      </div>
    </section>
    <section class="ct-write" aria-labelledby="ct-form-title">
      <form class="ct-form" id="ctForm" action={action} method="post" enctype={formEndpoint ? undefined : 'text/plain'} novalidate data-endpoint={formEndpoint} data-email={contact.email} data-wa={contact.whatsapp}>
        <h2 id="ct-form-title">Send an enquiry</h2>
        <fieldset class="ct-needs">
          <legend>What is it about?</legend>
          {[...CHAPTERS, 'Something else'].map(c => <label class="ct-chip"><input type="checkbox" name="about" value={c}><span>{c}</span></label>)}
        </fieldset>
        <div class="ct-row">
          <label class="ct-field"><span>Name</span><input name="name" autocomplete="name" required></label>
          <label class="ct-field"><span>Email</span><input name="email" type="email" inputmode="email" autocomplete="email" required></label>
        </div>
        <div class="ct-row ct-pair">
          <label class="ct-field"><span>Organisation <i>(optional)</i></span><input name="org" autocomplete="organization"></label>
          <label class="ct-field"><span>Phone <i>(optional)</i></span><input name="phone" type="tel" inputmode="tel" autocomplete="tel"></label>
        </div>
        <label class="ct-field ct-msg"><span>Message</span><textarea name="message" rows="4" required placeholder="The document or training, the timeline, anything we should know"></textarea></label>
        <div class="ct-send">
          <button class="btn btn-primary" type="submit">Send enquiry</button>
          <p class="ct-status" role="status" aria-live="polite"></p>
        </div>
        <p class="ct-note">Your details are used only to reply to you.</p>
      </form>
    </section>
  </div>
</Base>

<script>
  import '../scripts/contact.js';
</script>
