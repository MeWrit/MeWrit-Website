---
// A still design board for the proposed direction, for review only: no animation, nothing linked from
// the site. By day the drawings are ink on paper, generated in code on canvas from one perspective
// camera, so everything stands on the desk it belongs to; by night they are the lamplight film's own
// engraved worlds (src/scripts/lamp/worlds/), rendered here once each. A digital layer of interface
// cards sits over both. The logo is the original file, unaltered, always on paper.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter';
import { href } from '../../lib/url';
const logo = href('/brand/logo-original.png');
const nav = ['Practices', 'Academy', 'Publications', 'About', 'Contact'];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Lamplight board</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{--paper:#F3EEE3;--sheet:#FBF8F2;--ink:#13244F;--body:#45506A;--pen:#B4500F;--orange:#E07A1F;--mustard:#E0A82E;--wash:#8E9DBA;
    --night:#0B1735;--ivory:#EDE6D6;--gold:#E0B85A;
    --serif:'Fraunces Variable',Georgia,serif;--sans:'Inter Variable',system-ui,sans-serif;--hand:'Caveat',cursive}
  *{box-sizing:border-box;margin:0}
  body{background:#33353A;color:#E9E5DC;font-family:var(--sans)}
  .board{max-width:1320px;margin:0 auto;padding:56px 24px 120px}
  .bd-kicker{font:600 .72rem/1 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:#C9B990}
  .board > header h1{margin-top:14px;font:400 clamp(2rem,1.4rem + 2.4vw,3.4rem)/1.05 var(--serif);letter-spacing:-.015em;color:#F6F1E6}
  .bd-sub{margin-top:14px;max-width:74ch;font-size:1rem;line-height:1.6;color:#C8C3B8}
  .bd-sec{margin-top:72px}
  .bd-h{font:400 1.5rem/1.2 var(--serif);color:#F6F1E6;margin-bottom:6px}
  .bd-note{max-width:82ch;font-size:.92rem;line-height:1.6;color:#B9B4A9;margin:0 0 18px}
  .bd-cap{margin-top:10px;font-size:.85rem;line-height:1.5;color:#B9B4A9}

  .frame{position:relative;container-type:inline-size;width:100%;aspect-ratio:16/10;border-radius:4px;overflow:hidden;background:var(--paper);box-shadow:0 34px 70px -26px rgba(0,0,0,.7)}
  .frame.night{background:var(--night)}
  .frame canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
  .frame svg.leads{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2}

  /* the letterhead: the logo on its own paper, the links in the serif, the contacts as stationery
     carries them, a navy rule with a fine orange one beneath; on night chapters it stays paper */
  .lh{position:absolute;left:0;right:0;top:0;height:6.4cqw;display:flex;align-items:center;gap:3cqw;padding:0 4cqw;z-index:3}
  .lh.paper{background:var(--paper)}
  .lh::before{content:"";position:absolute;left:4cqw;right:4cqw;bottom:0;height:1px;background:rgba(19,36,79,.22)}
  .lh-logo{width:var(--lw);height:auto;display:block}
  .lh-nav{display:flex;gap:2.3cqw;margin-left:auto}
  .lh-nav a{font:400 1.18cqw/1 var(--serif);color:var(--ink);text-decoration:none}
  .lh-nav a:first-child{border-bottom:1px solid var(--orange);padding-bottom:.2cqw}
  .lh-contact{display:grid;gap:.25cqw;padding-left:2.2cqw;border-left:1px solid rgba(19,36,79,.25);font:400 .82cqw/1.2 var(--sans);color:var(--body)}
  .lh-cta{font:italic 400 1.15cqw/1 var(--serif);color:var(--ink);text-decoration:none;border-bottom:1.5px solid var(--orange);padding-bottom:.2cqw;white-space:nowrap}
  .lh.compact{height:4.6cqw}
  .lh.compact .lh-contact{display:none}
  .lh.phone{height:21cqw;padding:0 5cqw}
  .lh.phone::before{left:5cqw;right:5cqw}
  .lh{--lw:17.5cqw}
  .lh.compact{--lw:13cqw}
  .lh.phone{--lw:46cqw}
  /* by night, for now: no strip and no patch; the header turns ivory over the scene and names the
     chapter where the logo would be, the logo keeping to the paper chapters (it is never recoloured) */
  .night .lh-nav a{color:rgba(246,241,230,.92)}
  .night .lh-nav a:first-child{border-color:var(--gold)}
  .night :is(.lh-cta,.lh-menu){color:#F6F1E6;border-color:var(--gold)}
  .night .lh::before{background:rgba(237,230,214,.16)}
  .lh-run{font:500 1.05cqw/1 var(--serif);font-variant-caps:all-small-caps;letter-spacing:.14em;color:rgba(237,230,214,.78)}
  .lh.phone .lh-run{font-size:3.6cqw}
  .frame.band{aspect-ratio:16/3.6}
  .lh-menu{margin-left:auto;font:400 4.4cqw/1 var(--serif);color:var(--ink);border-bottom:1.5px solid var(--orange);padding-bottom:.6cqw}
  .strip{position:relative;container-type:inline-size;width:100%;border-radius:4px;overflow:hidden;background:var(--paper);box-shadow:0 20px 50px -24px rgba(0,0,0,.7);margin-bottom:16px}
  .strip.desk{aspect-ratio:16/1.35}
  .strip.desk.small{aspect-ratio:16/1.05}

  /* page furniture, the book's own: a running head, a folio, figure legends */
  .rh{position:absolute;top:8.2cqw;left:4cqw;right:4cqw;display:flex;justify-content:space-between;font:500 1cqw/1 var(--serif);font-variant-caps:all-small-caps;letter-spacing:.14em;color:rgba(19,36,79,.68);z-index:3}
  .folio{position:absolute;bottom:2.4cqw;left:50%;transform:translateX(-50%);font:italic 400 1.35cqw/1 var(--serif);color:rgba(19,36,79,.6);z-index:3}
  .legend{position:absolute;font:italic 400 1.02cqw/1.35 var(--serif);color:rgba(19,36,79,.78);z-index:3}
  .night .rh{top:12.5cqw;color:rgba(237,230,214,.62)}
  .night .folio{color:rgba(237,230,214,.6)}
  .night .legend{color:rgba(237,230,214,.75)}

  /* the caption: one headline, one line, one way on */
  .cap{position:absolute;left:4.6cqw;bottom:6.6cqw;width:41cqw;z-index:3}
  .cap::before{content:"";position:absolute;inset:-6cqw -8cqw -4cqw -8cqw;z-index:-1;background:radial-gradient(closest-side,rgba(243,238,227,.95),rgba(243,238,227,.72) 60%,rgba(243,238,227,0))}
  .cap .k{font:500 1.05cqw/1 var(--serif);font-variant-caps:all-small-caps;letter-spacing:.14em;color:var(--pen);margin-bottom:1.3cqw}
  .cap h2{font:400 4.7cqw/1.02 var(--serif);letter-spacing:-.018em;color:var(--ink)}
  .cap p{margin-top:1.5cqw;font:400 1.3cqw/1.55 var(--sans);color:var(--body);max-width:36cqw}
  .cap a{display:inline-block;margin-top:1.6cqw;font:italic 400 1.35cqw/1 var(--serif);color:var(--ink);text-decoration:none;border-bottom:1.5px solid var(--orange);padding-bottom:.25cqw}
  .hl{background:linear-gradient(176deg,transparent 46%,rgba(224,168,46,.58) 47%,rgba(224,168,46,.5) 88%,transparent 89%);padding:0 .06em;margin:0 -.06em}
  .night .cap::before{inset:-4cqw -2.6cqw -2.8cqw -2.6cqw;background:radial-gradient(closest-side,rgba(8,16,40,.55),rgba(8,16,40,.3) 60%,rgba(8,16,40,0))}
  .night .cap .k{color:var(--gold)}
  .night .cap h2{color:#F6F1E6}
  .night .cap p{color:rgba(237,230,214,.84)}
  .night .cap a{color:#F6F1E6;border-color:var(--gold)}
  .night .hl{background:linear-gradient(180deg,transparent 88%,rgba(224,184,90,.95) 88%,rgba(224,184,90,.95) 93%,transparent 93%);-webkit-box-decoration-break:clone;box-decoration-break:clone}
  .cap .btn{display:inline-flex;align-items:center;gap:.8cqw;margin-top:2cqw;padding:1.1cqw 1.9cqw;border-radius:.4cqw;background:var(--orange);color:#fff;font:600 1.15cqw/1 var(--sans);border:0;text-decoration:none}
  .contact-row{position:absolute;left:4.6cqw;right:4.6cqw;bottom:2.4cqw;display:flex;gap:2.4cqw;font:500 .9cqw/1 var(--serif);font-variant-caps:all-small-caps;letter-spacing:.14em;color:rgba(237,230,214,.72);z-index:3}

  /* the digital layer: crisp interface cards over the drawn world */
  .chip{position:absolute;z-index:4;display:flex;flex-direction:column;gap:.3cqw;padding:.8cqw 1.05cqw;border-radius:.6cqw;background:rgba(253,251,247,.96);border:1px solid rgba(19,36,79,.14);box-shadow:0 .6cqw 1.8cqw rgba(19,36,79,.16);font:400 .88cqw/1.3 var(--sans);color:var(--body);white-space:nowrap}
  .chip b{display:flex;align-items:center;gap:.45cqw;font:600 .7cqw/1 var(--sans);letter-spacing:.09em;text-transform:uppercase;color:var(--ink)}
  .chip .ok{color:var(--pen);font-weight:600}
  .chip .ai{color:var(--pen);font-size:.95cqw;letter-spacing:0}
  .chip .live{width:.55cqw;height:.55cqw;border-radius:50%;background:var(--orange);box-shadow:0 0 0 .25cqw rgba(224,122,31,.18)}
  .night .chip{background:rgba(10,20,48,.82);border-color:rgba(237,230,214,.22);color:rgba(237,230,214,.82);box-shadow:0 .6cqw 1.8cqw rgba(0,0,0,.35);backdrop-filter:blur(6px)}
  .night .chip b{color:#F6F1E6}
  .night .chip .ok,.night .chip .ai{color:var(--gold)}
  .night .chip .live{background:var(--gold);box-shadow:0 0 0 .25cqw rgba(224,184,90,.2)}

  /* the work on screen: an editor in the site's own type and colours */
  .ui{position:absolute;z-index:3;display:flex;flex-direction:column;background:#FDFBF6;overflow:hidden;font-family:var(--sans);color:var(--ink)}
  .ui-bar{display:flex;align-items:center;gap:1.2cqw;padding:.85cqw 1.4cqw;border-bottom:1px solid rgba(19,36,79,.12);background:#F6F2E9;font-size:.92cqw}
  .ui-bar .dots{display:flex;gap:.45cqw}
  .ui-bar .dots i{width:.7cqw;height:.7cqw;border-radius:50%;background:rgba(19,36,79,.22)}
  .ui-bar .dots i:first-child{background:rgba(224,122,31,.75)}
  .ui-bar .dots i:nth-child(2){background:rgba(224,168,46,.75)}
  .ui-bar b{font:600 .95cqw/1 var(--sans)}
  .ui-saved{margin-left:auto;display:flex;align-items:center;gap:.5cqw;color:var(--body);font-size:.85cqw}
  .ui-av{display:flex;gap:.3cqw}
  .ui-av i{display:grid;place-items:center;width:1.9cqw;height:1.9cqw;border-radius:50%;background:var(--ink);color:#fff;font:600 .68cqw/1 var(--sans);font-style:normal}
  .ui-av i.ai{background:#FFF6EC;color:var(--pen);border:1px solid rgba(180,80,15,.45);font-size:.9cqw}
  .ui-body{flex:1;display:grid;grid-template-columns:minmax(0,1fr) 21cqw;gap:2.2cqw;padding:2cqw 2.4cqw 1.4cqw;min-height:0}
  .ui-doc{min-width:0}
  .ui-doc p{font:400 1.06cqw/1.62 var(--serif);color:#26324F;margin-bottom:.95cqw}
  .ui-doc .ui-sec{font:600 1.45cqw/1.2 var(--serif);color:var(--ink);margin-bottom:1.1cqw}
  .ui-doc del{color:var(--pen);text-decoration-thickness:1.5px}
  .ui-doc ins{color:var(--pen);text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:.15em}
  .ui-doc mark{background:linear-gradient(transparent 12%,rgba(224,168,46,.42) 12%,rgba(224,168,46,.42) 92%,transparent 92%);color:inherit}
  .ui-doc .ui-ghost{color:rgba(180,80,15,.85);font-style:italic;border-left:2px solid rgba(180,80,15,.55);padding-left:1cqw}
  .ui-fig{display:flex;gap:1.6cqw;align-items:center;margin:.4cqw 0 1cqw}
  .ui-fig svg{width:18cqw;height:auto;flex:none}
  .ui-fig span{font:italic 400 .9cqw/1.35 var(--serif);color:var(--body)}
  .ui-side{display:flex;flex-direction:column;gap:.9cqw}
  .ui-tab{width:100%;border-collapse:collapse;margin:.2cqw 0 1cqw;font:400 .86cqw/1.3 var(--sans);color:#26324F}
  .ui-tab caption{text-align:left;font:italic 400 .9cqw/1.35 var(--serif);color:var(--body);padding-bottom:.5cqw}
  .ui-tab th{font-weight:600;text-align:left;padding:.4cqw .6cqw;border-top:1px solid rgba(19,36,79,.5);border-bottom:1px solid rgba(19,36,79,.25)}
  .ui-tab td{padding:.4cqw .6cqw;border-bottom:1px solid rgba(19,36,79,.12)}
  .ui-tab tr:last-child td{border-bottom:1px solid rgba(19,36,79,.5)}
  .ui-card{display:flex;flex-direction:column;gap:.35cqw;padding:.95cqw 1.15cqw;border-radius:.45cqw;border:1px solid rgba(19,36,79,.14);background:#fff;font-size:.9cqw;line-height:1.35;color:var(--body)}
  .ui-card b{font:600 .72cqw/1 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--ink)}
  .ui-card.ai{border-color:rgba(180,80,15,.35);background:#FFFAF3}
  .ui-card.ai b{color:var(--pen)}
  .ui-card em{font-style:normal;font-size:.8cqw;color:var(--pen)}
  .ui-foot{display:flex;justify-content:space-between;padding:.75cqw 1.4cqw;border-top:1px solid rgba(19,36,79,.12);font-size:.8cqw;color:var(--body)}

  /* the storyboard */
  .sb{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
  .sb .frame .n{position:absolute;left:3cqw;top:3cqw;font:italic 400 4cqw/1 var(--serif);color:rgba(19,36,79,.75);z-index:3}
  .sb .frame.night .n{color:rgba(237,230,214,.8)}

  /* palette and type */
  .pt{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
  .card{background:var(--paper);color:var(--ink);border-radius:4px;padding:26px 28px;box-shadow:0 20px 50px -24px rgba(0,0,0,.7)}
  .card.nightcard{background:var(--night);color:var(--ivory)}
  .card h3{font:500 .78rem/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px;color:#8A8577}
  .card.nightcard h3{color:rgba(237,230,214,.6)}
  .sw{display:grid;grid-template-columns:52px 1fr;gap:12px 14px;align-items:center}
  .sw i{display:block;width:52px;height:38px;border-radius:3px;border:1px solid rgba(19,36,79,.15)}
  .card.nightcard .sw i{border-color:rgba(237,230,214,.18)}
  .sw b{display:block;font:500 .95rem/1.2 var(--serif)}
  .sw span{font-size:.78rem;color:var(--body)}
  .card.nightcard .sw span{color:rgba(237,230,214,.65)}
  .ty > * + *{margin-top:16px}
  .ty .t1{font:400 2.3rem/1 var(--serif);letter-spacing:-.015em}
  .ty .t2{font:italic 400 1.02rem/1.4 var(--serif);color:rgba(19,36,79,.8)}
  .ty .t3{font:500 .95rem/1 var(--serif);font-variant-caps:all-small-caps;letter-spacing:.16em;color:var(--pen)}
  .ty .t5{font:600 1.8rem/1 var(--hand);color:var(--pen)}
  .ty small{display:block;font:500 .66rem/1 var(--sans);letter-spacing:.12em;text-transform:uppercase;color:#8A8577;margin-bottom:6px}
  .ty .chipdemo{position:static;display:inline-flex;font-size:.82rem;padding:9px 12px;border-radius:7px;gap:4px}
  .ty .chipdemo b{font-size:.64rem}

  /* phones */
  .ph-row{display:flex;gap:28px;align-items:flex-start;flex-wrap:wrap}
  .frame.phone{width:360px;max-width:100%;aspect-ratio:390/844;border-radius:28px}
  .frame.phone .cap{left:6cqw;right:6cqw;width:auto;bottom:11cqw}
  .frame.phone .cap .k{font-size:3.4cqw;margin-bottom:3cqw}
  .frame.phone .cap h2{font-size:11.5cqw}
  .frame.phone .cap p{font-size:4cqw;max-width:none;margin-top:3.2cqw}
  .frame.phone .cap a{font-size:4.2cqw;margin-top:4cqw}
  .frame.phone .folio{font-size:4cqw;bottom:4cqw}
  .frame.phone .chip{font-size:3cqw;padding:2.2cqw 2.8cqw;border-radius:1.8cqw;gap:.9cqw}
  .frame.phone .chip b{font-size:2.4cqw;gap:1.2cqw}
  .frame.phone .chip .ai{font-size:3cqw}
  @media (max-width:980px){.pt{grid-template-columns:1fr}}
  @media (max-width:820px){.sb{grid-template-columns:1fr}}
</style>
</head>
<body>
<main class="board">
  <header>
    <p class="bd-kicker">MeWriT website · direction preview · still frames, round two</p>
    <h1>Day and night chapters in turn, a digital layer over both</h1>
    <p class="bd-sub">The palette, type and letterhead as round one had them. The chapters now alternate: the study and the reading room by day, in ink on paper; the archive and the star map by night, the film's own engraved worlds; the editor by day again; the sunset to close. By night the header turns ivory over the scene, and the logo keeps to the paper chapters. A crisp digital layer runs over everything: the work as it is really done, on screen, checked, assisted, submitted. Still frames only; words are placeholders.</p>
  </header>

  <section class="bd-sec">
    <h2 class="bd-h">1 · The header, as a letterhead</h2>
    <p class="bd-note">By day the letterhead is simply the top of the page: the logo on its paper, the links in the serif, the contacts as stationery carries them, one fine grey rule beneath. By night, for now, there is no strip and no patch: the header turns ivory over the scene and names the chapter where the logo would be, and the logo keeps to the paper chapters. A navy logo cannot sit on the dark without something light behind it, and every light ground drew the eye; an approved version of the logo for dark grounds would settle it.</p>
    <div class="strip desk">
      <div class="lh"><img class="lh-logo" src={logo} alt="MeWriT, Writing Science Right"><nav class="lh-nav">{nav.map(n => <a href="#">{n}</a>)}</nav><div class="lh-contact"><span>+91 97277 16506</span><span>hetal@mewrit.com</span></div><a class="lh-cta" href="#">Start a project</a></div>
    </div>
    <div class="strip desk small">
      <div class="lh compact"><img class="lh-logo" src={logo} alt=""><nav class="lh-nav">{nav.map(n => <a href="#">{n}</a>)}</nav><a class="lh-cta" href="#">Start a project</a></div>
    </div>
    <div class="frame night band">
      <canvas data-world="archive" data-crop="top"></canvas>
      <div class="lh compact"><span class="lh-run">Regulatory writing · Chapter 2</span><nav class="lh-nav">{nav.map(n => <a href="#">{n}</a>)}</nav><a class="lh-cta" href="#">Start a project</a></div>
    </div>
    <p class="bd-cap">By night, for now: the chapter named where the logo would be, the links in ivory, one faint rule.</p>
  </section>

  <section class="bd-sec">
    <h2 class="bd-h">2 · Morning: the study</h2>
    <p class="bd-note">One camera for the whole room, so the desk has a real top and edge and every object stands on it with its own shadow: the display with the draft open, keyboard and trackpad, a tablet with the reviewer's stylus notes, a stethoscope, reading glasses, coffee, a lamp, reference volumes, certificates on the wall. Through the doorway, the archive: the next room, and the next chapter. The paper is clean, the light is soft, and the cards name what is happening as it happens.</p>
    <div class="frame" id="f-study">
      <canvas data-scene="study"></canvas>
      <div class="lh paper"><img class="lh-logo" src={logo} alt="MeWriT, Writing Science Right"><nav class="lh-nav">{nav.map(n => <a href="#">{n}</a>)}</nav><div class="lh-contact"><span>+91 97277 16506</span><span>hetal@mewrit.com</span></div><a class="lh-cta" href="#">Start a project</a></div>
      <div class="rh"><span>The study</span><span>Chapter i</span></div>
      <svg class="leads" viewBox="0 0 1280 800" preserveAspectRatio="none" data-leads="study"></svg>
      <div class="chip" data-at="study:draft"><b><i class="live"></i>Draft 3</b><span>Saved to the cloud · just now</span></div>
      <div class="chip" data-at="study:rev"><b>Reviewer</b><span>Checked against ICH E3 <span class="ok">✓</span></span></div>
      <div class="chip" data-at="study:ai"><b><span class="ai">✦</span>Assistant</b><span>42 of 42 references verified</span></div>
      <div class="cap"><p class="k">MeWriT · Medical writing</p><h2>Writing <span class="hl">Science</span> Right</h2><p>Specialist medical writing and scientific communication: expert judgement, with today's tools.</p><a href="#">Begin reading</a></div>
      <div class="folio">i</div>
    </div>
  </section>

  <section class="bd-sec">
    <h2 class="bd-h">3 · Night: regulatory writing, the archive</h2>
    <p class="bd-note">The archive you liked, exactly as the film draws it, full bleed: the aisle of stacks in steel blue, the shaft of light with dust turning in it, the window at the far end. The page arrives as the dossier, ivory in the dark; the digital layer validates it for e-submission.</p>
    <div class="frame night" id="f-archive">
      <canvas data-world="archive" data-over="dossier"></canvas>
      <div class="lh compact"><span class="lh-run">Regulatory writing · Chapter 2</span><nav class="lh-nav">{nav.map(n => <a href="#">{n}</a>)}</nav><a class="lh-cta" href="#">Start a project</a></div>
      <div class="chip" data-at="archive:ectd"><b>eCTD · Module 2.7</b><span>Validated <span class="ok">✓</span></span></div>
