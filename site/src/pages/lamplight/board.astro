  composer.addPass(new RenderPass(scene, camera));
  composer.addPass(new UnrealBloomPass(new THREE.Vector2(256, 256), .6, .5, .16));
  composer.addPass(new OutputPass());
  const makers = { archive: archiveWorld, sky: skyWorld, dawn: dawnWorld, reading: readingWorld }, worlds = {};
  const get = id => { if (!worlds[id]) { const w = makers[id](THREE, { quality: 'high' }); scene.add(w.group); w.setWeight(0); worlds[id] = w; } return worlds[id]; };

  // the stage's box fitted to its target on the frame, as the film's fit-to-frame does it
  function fit(stage, W, H, t, yaw = 0) {
