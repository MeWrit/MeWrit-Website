      if (k === 'sky:map') { L = st[0] * 100 + 3.5; T = st[1] * 100 * ar - 2.2; }
      else if (k === 'archive:legend') { L = x0 * 100; T = (y1 + .035) * 100 * ar; }
      else if (k === 'dawn:call') { L = x0 * 100 - 17; T = (y1 - .2) * 100 * ar; }
      else { L = x0 * 100 - 10; T = (y0 + .06 + i * .27) * 100 * ar; }
      el.style.left = L + 'cqw'; el.style.top = T + 'cqw';
    });
  });
}

(async () => {
  await document.fonts.ready;
  try { await document.fonts.load('600 22px Caveat'); } catch (e) { /* the notes fall back to the cursive face */ }
  const two = [...document.querySelectorAll('canvas[data-scene]')], three = [...document.querySelectorAll('canvas[data-world]')];
  let E = null;
  const run = () => {
    two.forEach(paint2d);
    if (!E) { try { E = engine(); } catch (e) { console.error('[board] webgl', e); } }
    if (E) three.forEach(cv => { try { paint3d(cv, E); } catch (e) { console.error('[board]', cv.dataset.world, e); } });
    place();
  };
  run();
  let t = 0; addEventListener('resize', () => { clearTimeout(t); t = setTimeout(run, 250); });
  window.boardReady = true;
})();
</script>
</body>
</html>
