---
// The home page: one film. While it loads, the site's loader writes the logo on paper (Base's
// loader="wait": SiteLoader.astro); as it lifts the film is where the reader was (a refresh) or at
// the start, where the dust gathers into a blank page that writes itself. Then one cloud of
// particles takes a shape for each scene as you scroll: three screens at night that say what MeWriT
// is, who writes and why it is chosen (the figures among them); the five practices to choose from, on
// dusk indigo, as five tiles with their shapes in them; each practice by day, reached through a dawn
// (a tile goes straight to its practice); and the close at night, where the foot opens. Each scene's
// words stand in two columns (.xp-col-a, .xp-col-b), so a shape can stand beside them, between them,
// across the middle of the screen with the words above and the figures below, or in tiles
// (data-layout). The scenes are in
// src/scripts/xp/scenes.js, their words in src/data/experience.ts, the 3D in src/scripts/xp/world.js.
// The words are real page content: they read in order without the 3D.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { experience, practicePages } from '../data/experience';
import { practices } from '../data/pitch';
import { SCENES, CHAPTERS } from '../scripts/xp/scenes.js';
import { site, contact } from '../data/site';
import { href } from '../lib/url';
import portrait from '../assets/hetal-shah.png';
import '../styles/xp.css';

// the words, in the scenes' order (a scene without words fails the build)
const words = SCENES.map(s => {
  const w = experience.scenes.find(x => x.id === s.id);
  if (!w) throw new Error(`experience: no words for the scene "${s.id}"`);
  return w;
});
// titles letter by letter, each letter with its own moment (the same on every build)
let seed = 11;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const letters = (t: string) => t.split(' ').map(word => [...word].map(ch => ({ ch, d: Math.round(rnd() * 560) })));
const pad = (j: number) => String(j + 1).padStart(2, '0');
const fulls = practices.list.map(p => p.full);
// where a link can land in the film (/#who, /#training, ...: the menus' links, experience.js): the intro's
// scenes by their own names, and each practice's first scene by the practice's address
const anchorOf = (s: { id: string; chapter: number }, i: number) =>
  ['who', 'why', 'voices', 'practices'].includes(s.id) ? s.id
    : s.chapter >= 0 && SCENES.findIndex(x => x.chapter === s.chapter) === i ? practicePages[s.chapter] : undefined;
---
<Base intro="none" theme="light" foot="film" loader="wait" title={`${experience.title} | ${site.name}`} description={experience.description}>
  {/* (data-foot-auto: at the film's end the foot opens by itself, on this page only: foot.js) */}
  <section class="xp" id="xp" aria-label={experience.title} style={`--units:${SCENES.length}`} data-foot-auto>
    <canvas class="xp-canvas" aria-hidden="true"></canvas>
    <div class="xp-track">
      <div class="xp-stage">
        <div class="xp-shade" aria-hidden="true"></div>
        <div class="xp-shade-day" aria-hidden="true"></div>
        <div class="xp-callouts" aria-hidden="true"></div>
        <div class="xp-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="xp-scenes">
          {SCENES.map((s, i) => {
            const w = words[i], Tag = i === 0 ? 'h1' : 'h2';
            return (
              <article class="xp-scene" id={anchorOf(s, i)} data-scene={s.id} data-light={s.light ? 'day' : 'night'} data-layout={s.layout || 'right'}>
                <div class="xp-col xp-col-a">
                  <p class="xp-kicker"><span class="sr-only">{w.kicker}</span><span class="xp-kick" aria-hidden="true">{w.kicker}</span></p>
                  <Tag class="xp-title"><span class="sr-only">{w.title}</span><span aria-hidden="true">{letters(w.title).map((word, wi) => <>{wi > 0 && ' '}<span class="w">{word.map(l => <span class="c" style={`--d:${l.d}`}>{l.ch}</span>)}</span></>)}</span></Tag>
                </div>
                <div class="xp-col xp-col-b">
                  <p class="xp-text">{w.text}</p>
                  {w.lead && <a class="xp-lead" href={href('/hetal/')}><Image class="xp-face" src={portrait} alt="" width={96} height={96} /><span>{w.lead} <b aria-hidden="true">→</b></span></a>}
                  {w.figures && <ul class="xp-figs" aria-label="MeWriT in figures">{w.figures.map((f, j) => {
                    // the figure, and its count up (experience.js): the running count over an unseen copy; a
                    // figure with a page of its own (the publications, the therapeutic areas) is the way there
                    const v = f.value.replace(/\+$/, '');
                    const inner = <><b><span class="sr-only">{f.value}</span><span class="xp-count" data-to={v.replace(/\D/g, '')} aria-hidden="true"><span>{v}</span><span>{v}</span></span>{f.value.endsWith('+') && <i aria-hidden="true">+</i>}</b><span class="xp-fl">{f.label}{f.href && <>{' '}<i class="xp-fgo" aria-hidden="true">→</i></>}</span></>;
                    return <li style={`--i:${j}`}>{f.href ? <a class="xp-flink" href={href(f.href)}>{inner}</a> : inner}</li>;
                  })}</ul>}
                  {w.points && <ol class="xp-points">{w.points.map((p, j) => <li><span class="n" aria-hidden="true">{pad(j)}</span><b>{p.title}</b><span class="d">{p.text}</span></li>)}</ol>}
                  {/* the testimonials, one at a time (experience.js turns them, and the page is signed again
                      as each comes in): stacked in one place, so the words keep one height; without scripts,
                      every one in turn */}
                  {w.quotes && <div class="xp-voices" role="region" aria-roledescription="carousel" aria-label="What clients say">
                    <div class="xp-qs" aria-live="off">
                      {w.quotes.map((q, j) => <figure class={j ? 'xp-q' : 'xp-q on'} role="group" aria-roledescription="slide" aria-label={`${j + 1} of ${w.quotes!.length}`}>
                        <blockquote><p>{q.quote}</p></blockquote>
                        <figcaption>{q.by}</figcaption>
                      </figure>)}
                    </div>
                    <div class="xp-qnav">
                      <button class="xp-qbtn xp-qprev" type="button" aria-label="Previous testimonial"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
                      <span class="xp-qdots" aria-hidden="true">{w.quotes.map((_, j) => <i class={j ? '' : 'on'}><b></b></i>)}</span>
                      <button class="xp-qbtn xp-qnext" type="button" aria-label="Next testimonial"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
                      <button class="xp-qbtn xp-qpause" type="button" aria-label="Pause the testimonials"><svg class="xp-qi-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="6" width="3.2" height="12" rx="1"/><rect x="13.8" y="6" width="3.2" height="12" rx="1"/></svg><svg class="xp-qi-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.5 6.2v11.6c0 .7.8 1.1 1.4.7l8.4-5.8c.5-.4.5-1.1 0-1.4L9.9 5.5c-.6-.4-1.4 0-1.4.7z"/></svg></button>
                    </div>
                  </div>}
                  {w.hint && <p class="xp-pickhint">{w.hint}</p>}
                  {w.docs && <ul class="xp-docs" aria-label="What it covers">{w.docs.map(d => <li>{d}</li>)}</ul>}
                  {w.hub && <>
                    <div class="btn-row xp-cta"><button class="btn btn-primary xp-explore" type="button">Explore all five</button></div>
                    {/* each practice a tile: its number, its shape (the 3D, set in the tile's art by experience.js), its name and what it covers; on phones a sixth tile goes to all five */}
                    <ol class="xp-tiles" aria-label="The five practices">
                      {CHAPTERS.map((c, j) => <li><button class="xp-tile" type="button" data-practice={j}><span class="n">{pad(j)}</span><span class="xp-tile-art" aria-hidden="true"></span><span class="t">{c}</span><span class="f">{fulls[j]}</span><b aria-hidden="true">{'→'}</b></button></li>)}
                      <li class="xp-tile-all"><button class="xp-tile xp-explore" type="button"><span class="t">Explore all five</span><b aria-hidden="true">{'→'}</b></button></li>
                    </ol>
                  </>}
                  {/* (the practices' own pages are not built yet: each practice leads to the contact page for now) */}
                  {w.more && <div class="xp-morerow">
                    <a class="xp-more" href={href('/contact/')}>{w.academy ? 'Plan a training' : 'Discuss your project'}<span class="sr-only">: {CHAPTERS[s.chapter]}</span> <b aria-hidden="true">{'→'}</b></a>
                    {/* (training: the Academy's open workshops and courses, from the practice itself) */}
                    {w.academy && <a class="xp-acad" href={contact.academy} target="_blank" rel="noopener">MeWriT Academy <span aria-hidden="true">↗</span></a>}
                  </div>}
                  {w.cta && <div class="btn-row xp-cta">
                    <a class="btn btn-primary" href={href('/contact/')}>Start a project</a>
                    <a class="btn xp-btn-ghost" href={contact.academy} target="_blank" rel="noopener">Book a training</a>
                  </div>}
                </div>
              </article>
            );
          })}
        </div>
        <div class="xp-hud">
          <div class="xp-panel" aria-hidden="true">
            <dl class="xp-readout"></dl>
            <p class="xp-note" hidden></p>
          </div>
          <button class="xp-hint" type="button"><span>Scroll to explore</span><i aria-hidden="true"></i></button>
          <nav class="xp-railnav" aria-label="Practices">
            <ol class="xp-rail">
              {CHAPTERS.map((c, j) => <li><button type="button" aria-current="false"><i aria-hidden="true"><b></b></i><span class="n" aria-hidden="true">{pad(j)}</span><span class="t">{c}</span></button></li>)}
            </ol>
          </nav>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/xp/experience.js';
</script>
